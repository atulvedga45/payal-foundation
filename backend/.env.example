# Database Connection
# To use PostgreSQL, set your postgres connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samajseva
# If empty or unreachable, defaults cleanly to sqlite:///./samajseva.db for instant zero-config testing!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samajseva

# App Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Admin Security
ADMIN_SECRET_KEY=admin123
